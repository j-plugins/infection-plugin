<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.xepozz.infection</id>
    <name>Infection</name>
    <vendor email="xepozz@list.ru" url="https://github.com/xepozz">Dmitrii Derepko (@xepozz)</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>
    <depends config-file="php-remote-interpreter.xml" optional="true">
        org.jetbrains.plugins.phpstorm-remote-interpreter
    </depends>

    <resource-bundle>messages.InfectionBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceImplementation="com.github.xepozz.infection.results.MutationResultsService"/>
        <statusBarWidgetFactory
                id="InfectionMsi"
                order="last"
                implementation="com.github.xepozz.infection.statusbar.InfectionMsiWidgetFactory"/>
        <localInspection
                language="PHP"
                shortName="InfectionEscapedMutant"
                bundle="messages.InfectionBundle"
                groupBundle="messages.InfectionBundle"
                groupKey="inspection.group.mutationTesting"
                key="inspection.escapedMutant.displayName"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.github.xepozz.infection.inspection.EscapedMutantInspection"/>
        <codeInsight.lineMarkerProvider
                language="PHP"
                implementationClass="com.github.xepozz.infection.gutter.InfectionMutationLineMarkerProvider"/>
        <postStartupActivity
                implementation="com.github.xepozz.infection.gutter.MutationResultsRefresherActivity"/>
        <configurationType
                implementation="com.github.xepozz.infection.tests.run.InfectionRunConfigurationType"/>
        <runConfigurationProducer
                implementation="com.github.xepozz.infection.tests.run.InfectionRunConfigurationProducer"/>
        <runAnything.executionProvider
                implementation="com.github.xepozz.infection.tests.runAnything.InfectionRunAnythingProvider"/>

        <programRunner implementation="com.github.xepozz.infection.tests.run.InfectionDebugRunner"/>
<!--        <phpRunConfigurationExtension-->
<!--                implementation="com.jetbrains.php.remote.docker.compose.PhpDockerRunConfigurationExtension"/>-->
    </extensions>

    <projectListeners>
        <listener class="com.github.xepozz.infection.tests.InfectionTestStatusListener"
                  topic="com.intellij.execution.testframework.sm.runner.SMTRunnerEventsListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="com.jetbrains.php">
        <openSettingsProvider
                implementation="com.github.xepozz.infection.InfectionOpenSettingsProvider"/>
        <config.interpreters.PhpInterpretersStateListener
                implementation="com.github.xepozz.infection.InfectionInterpreterStateListener"/>
        <testFrameworkType
                implementation="com.github.xepozz.infection.tests.InfectionFrameworkType"/>
    </extensions>

    <actions>
        <action id="com.github.xepozz.infection.tests.actions.CopyMutationIdAction"
                class="com.github.xepozz.infection.tests.actions.CopyMutationIdAction"
                text="Copy Mutation ID"
                description="Copy mutation ID to clipboard">
            <add-to-group group-id="TestTreePopupMenu" anchor="last"/>
        </action>
        <action id="com.github.xepozz.infection.diagnostics.ShowStoredMutantsAction"
                class="com.github.xepozz.infection.diagnostics.ShowStoredMutantsAction"
                text="Show Stored Infection Mutants"
                description="Diagnostic: list every mutant currently held by the plugin">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
